		{"id":"be9705ef84159df4","type":"text","text":"","x":420,"y":0,"width":380,"height":60},
		{"id":"274491e00422cb64","type":"text","text":"Melantha, Alabaster, ","x":420,"y":80,"width":380,"height":60},
		{"id":"e2d445810a3a3605","type":"text","text":"The One Who Casts","x":420,"y":160,"width":380,"height":60},
		{"id":"a010ba8e49f6c57f","type":"text","text":"","x":420,"y":240,"width":380,"height":60},
		{"id":"52e1cc84e22f3c1d","type":"text","text":"","x":420,"y":320,"width":380,"height":60},
