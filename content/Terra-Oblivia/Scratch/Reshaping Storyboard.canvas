		{"id":"d7d48f82bb9c348c","x":-296,"y":-121,"width":250,"height":176,"type":"text","text":"Ivys dies. Soul is split between devil and mortal, mortal soul fades, demon soul is destroyed. Knowledge is stored within Graveglass."},
